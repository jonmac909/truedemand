# =============================================================================
# TrueDemand Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# =============================================================================
# Supabase Configuration (REQUIRED)
# =============================================================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key for worker (has admin access to database)
# SECURITY: Never expose this key in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# LLM API Keys (REQUIRED for validation and blueprint generation)
# =============================================================================
# Anthropic Claude API key for LLM prompts
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# External Data Source API Keys (REQUIRED for validation signals)
# =============================================================================
# Apify API key for TikTok data scraping
# Get from: https://console.apify.com/
APIFY_API_KEY=your-apify-api-key-here

# NOTE: Reddit signals use public JSON API (no authentication required)
# Google Trends uses unauthenticated API

# =============================================================================
# Worker Configuration (OPTIONAL - has sensible defaults)
# =============================================================================
# How often the worker polls for new jobs (milliseconds)
# Default: 2000 (2 seconds)
WORKER_POLL_INTERVAL_MS=2000

# How often the worker sends heartbeat signals (milliseconds)
# Default: 15000 (15 seconds)
WORKER_HEARTBEAT_INTERVAL_MS=15000

# How often to check for stale jobs (milliseconds)
# Default: 60000 (1 minute)
WORKER_STALE_JOB_CHECK_INTERVAL_MS=60000

# Jobs with heartbeats older than this are considered stale (seconds)
# Default: 300 (5 minutes)
WORKER_STALE_JOB_THRESHOLD_SECONDS=300

# =============================================================================
# Testing (OPTIONAL)
# =============================================================================
# Base URL for Playwright tests
# Default: http://localhost:3000
# TEST_BASE_URL=http://localhost:3000
